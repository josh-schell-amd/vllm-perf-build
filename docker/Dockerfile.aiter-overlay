# Overlay a nightly AITER wheel onto an already-published vLLM ROCm image.
#
# The lightweight alternative to rebuilding Dockerfile.rocm_base: instead of
# compiling AITER (and everything else) from source, take the prebuilt nightly
# image and swap the bundled AITER wheel for the newest published nightly wheel
# (rocm7.2.3 by default). No kernel compile, so this is fast.
#
# Build args:
#   BASE_IMAGE      - the published nightly, e.g. vllm/vllm-openai-rocm:nightly-<sha>
#   AITER_WHEEL_URL - direct URL of the amd-aiter nightly wheel to install
#   VLLM_COMMIT     - recorded in /app/versions.txt for traceability

ARG BASE_IMAGE=vllm/vllm-openai-rocm:nightly
FROM ${BASE_IMAGE}

ARG AITER_WHEEL_URL
ARG VLLM_COMMIT=unknown

# Fail early rather than silently shipping the stock AITER.
RUN test -n "${AITER_WHEEL_URL}" || (echo "AITER_WHEEL_URL build-arg is required" >&2; exit 1)

# Drop the AITER wheel baked into the nightly, then install the requested one.
# vLLM ROCm nightlies ship it under the PyPI dist name amd-aiter (not aiter).
# --no-deps: the base image already satisfies AITER's dependencies; we only want
# to swap the AITER wheel itself, not perturb torch/triton/etc.
RUN python3 -m pip uninstall -y amd-aiter aiter || true \
    && python3 -m pip install --no-deps "${AITER_WHEEL_URL}" \
    && python3 -m pip show amd-aiter | grep -i '^Version:'

RUN mkdir -p /app \
    && printf 'VLLM_COMMIT=%s\nAITER_WHEEL_URL=%s\n' \
       "${VLLM_COMMIT}" "${AITER_WHEEL_URL}" >> /app/versions.txt
